# Copy this file to .env (same folder) and fill in real values.
# .env is git-ignored - never commit it.

PORT=5000

# Local MongoDB, or a MongoDB Atlas URI: mongodb+srv://<user>:<password>@<cluster>/foodbridge
MONGO_URI=mongodb://127.0.0.1:27017/foodbridge

# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Origin of the Vite dev server (used for CORS in development)
CLIENT_URL=http://localhost:5173
